{
  "manifest_version": 3,
  "name": "skool-dropzone",
  "version": "0.5.0",
  "description": "Member-side companion for Skool meetings — drop zone + chat + whiteboard + video share + instant presentation. Phase 5 (E2EE presentation sync).",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "host_permissions": ["http://localhost/*", "https://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://www.skool.com/live/*", "https://skool.com/live/*"],
      "js": ["content/crypto.js", "content/transport.js", "content/present.js", "content/panel.js"],
      "css": ["content/panel.css", "content/present.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "skool-dropzone (Phase 5)",
    "default_popup": "popup/popup.html"
  }
}
